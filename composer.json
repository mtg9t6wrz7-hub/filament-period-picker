{
    "name": "rmrook/filament-period-picker",
    "description": "A reusable, responsive date-range picker for Filament forms.",
    "keywords": [
        "filament",
        "laravel",
        "date-range",
        "period-picker"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Rmr\\FilamentPeriodPicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rmr\\FilamentPeriodPicker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rmr\\FilamentPeriodPicker\\PeriodPickerServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": "pint",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
